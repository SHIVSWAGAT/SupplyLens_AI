APP_NAME=SupplyLens AI
APP_ENV=development
HOST=0.0.0.0
PORT=8000
SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=90
DATABASE_URL=your_database_url_here
REDIS_URL=your_redis_url_here
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Allowed values: openai | gemini | ollama
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_PREDICTION_LOGGING=true
ENABLE_DB_PERSISTENCE=true
SHOW_DEMO_PASSWORD_HINTS=false
DEMO_ADMIN_PASSWORD=your_demo_admin_password_here
DEMO_SUPERUSER_PASSWORD=your_demo_superuser_password_here
DEMO_CARRIER_PASSWORD=your_demo_carrier_password_here
DEMO_FIELD_PASSWORD=your_demo_field_password_here
DEMO_USER_PASSWORD=your_demo_user_password_here
